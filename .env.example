# =============================================================================
# .env.example — copy to .env and fill in real values
# =============================================================================

# ── Django Core ──────────────────────────────────────────────────────────────
DEBUG=on
SECRET_KEY=django-insecure-change-me-to-a-real-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.django.dev
PORT=8000

# ── Vite / Frontend ─────────────────────────────────────────────────────────
DJANGO_VITE_DEV=True

# ── Admin Paths ──────────────────────────────────────────────────────────────
DJANGO_ADMIN_PATH=admin/
WAGTAIL_ADMIN_PATH=cms/

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_NAME=wagtail
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── Redis / Valkey ──────────────────────────────────────────────────────────
REDIS_LOCATION=redis://127.0.0.1:6379/1
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PASSWORD=

# ── Object Storage (S3 / MinIO / R2) ────────────────────────────────────────
AWS_STORAGE_BUCKET_NAME=mahmoudashraf-dev
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Leave empty for local dev; set to CDN domain in production
AWS_S3_CUSTOM_DOMAIN=

# ── reCAPTCHA ────────────────────────────────────────────────────────────────
# Public site key (safe to expose in frontend)
VITE_RECAPTCHA_SITE_KEY=
# Server-side secret key
RECAPTCHA_PRIVATE_KEY=

# ── Webmention ───────────────────────────────────────────────────────────────
WEBMENTION_TOKEN=
WEBMENTION_DOMAIN=

# ── OAuth Providers ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ── External APIs ────────────────────────────────────────────────────────────
TMDB_API_KEY=

# ── Meilisearch (optional) ──────────────────────────────────────────────────
# MEILISEARCH_HOST=http://127.0.0.1
# MEILISEARCH_PORT=7700
# MEILI_MASTER_KEY=

# ── Docker Compose ───────────────────────────────────────────────────────────
COMPOSE_FILE=compose.dev.yaml
# Required for production compose.yaml (image tag for GHCR)
# IMAGE_TAG=

# ── Production Only ──────────────────────────────────────────────────────────
# CSRF_TRUSTED_ORIGINS=https://mahmoudashraf.dev
# SECURE_SSL_REDIRECT=False

# Cloudflare frontend cache purging
# CLOUDFLARE_EMAIL=
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ZONEID=

# Gunicorn workers (used by bin/django-entrypoint.sh)
# WEB_CONCURRENCY=3

# ── Backup & Sync Scripts (bin/) ─────────────────────────────────────────────
# R2 upload config for bin/db-backup
# R2_REMOTE=r2-mahmoudashraf-dev
# R2_BUCKET=mahmoudashraf-dev
# R2_PATH=backups
# BACKUP_DIR=./backups
# RETENTION_DAYS=7

# Local MinIO bucket name for bin/media-sync
# MINIO_BUCKET=mawsh
# MINIO_ENDPOINT=http://localhost:9000

# Production VPS sync for bin/sync-prod
# PROD_SSH=ashrafvps
# PROD_DIR=projects/enabled/mahmoudashraf.dev
