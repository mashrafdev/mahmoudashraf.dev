# =============================================================================
# Production environment template for compose.yaml
# =============================================================================

DEBUG=false
DJANGO_SETTINGS_MODULE=config.django.prod
DJANGO_VITE_DEV=false
SECRET_KEY=
ALLOWED_HOSTS=mahmoudashraf.dev,www.mahmoudashraf.dev
CSRF_TRUSTED_ORIGINS=https://mahmoudashraf.dev,https://www.mahmoudashraf.dev
SECURE_SSL_REDIRECT=true
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_BACKENDS_LEVEL=WARNING
DJANGO_ADMINS=
INTERNAL_IPS=127.0.0.1,localhost
ACCOUNT_DEFAULT_HTTP_PROTOCOL=https

DJANGO_ADMIN_PATH=admin/
WAGTAIL_ADMIN_PATH=cms/

DB_NAME=wagtail
DB_USER=wagtail
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
CONN_HEALTH_CHECKS=true
DB_POOL=true

REDIS_PASSWORD=
REDIS_LOCATION=redis://redis:6379/1
REDIS_URL=redis://redis:6379/1

AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

# Cloudflare cache purging for Wagtail frontend cache.
# Use an API token with Zone:Cache Purge permission for this zone.
CLOUDFLARE_ZONEID=
CLOUDFLARE_CACHE_TOKEN=

WAGTAILADMIN_BASE_URL=https://mahmoudashraf.dev

RECAPTCHA_PRIVATE_KEY=
WEBMENTION_TOKEN=
WEBMENTION_DOMAIN=mahmoudashraf.dev

GITHUB_CLIENT_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

TMDB_API_KEY=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0

WEB_CONCURRENCY=3

# Written by deployment workflow. Set manually only for emergency operations.
# IMAGE_TAG=sha-...

# Backups
R2_REMOTE=r2-mahmoudashraf-prod-backups
R2_BUCKET=mahmoudashraf-prod-backups
R2_PATH=postgres
R2_ACCOUNT_ID=
# Optional explicit endpoint; defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_DIR=./backups
RETENTION_DAYS=14
REQUIRE_R2_UPLOAD=true
